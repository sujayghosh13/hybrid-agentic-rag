# Environment Variables Example
# Duplicate this file to .env and populate values as needed.

# API Keys (Placeholders for future use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=

# Phase 2: Hybrid Retrieval Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=hybrid_chunks
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
BM25_INDEX_PATH=data/processed/bm25_index.pkl
RETRIEVAL_TOP_K=10
RRF_K=60

# Phase 3: Cross-Encoder Re-ranking Settings
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES_COUNT=20
RERANK_TOP_K=5

# Phase 4A & 4B: Local Agent Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
AGENT_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=5
AGENT_MAX_HOPS=2
QUERY_REWRITER_ENABLED=true
SUFFICIENCY_CHECK_ENABLED=true

# Phase 5: Corrective RAG (CRAG) Settings
CRAG_ENABLED=true
CRAG_MIN_RERANK_SCORE=-5.0

# Phase 7: FastAPI Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Phase 8: Streamlit Frontend Settings
FASTAPI_BASE_URL=http://127.0.0.1:8000
